{
  "name": "idea-explorer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A Cloudflare Worker that explores ideas using Claude and commits research to GitHub",
  "scripts": {
    "dev": "alchemy dev --stage dev",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "build:cli": "tsdown",
    "dev:cli": "tsdown --watch",
    "check": "ultracite check .",
    "fix": "ultracite fix .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "lefthook": "^2.1.4",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "ultracite": "7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@clack/prompts": "^1.1.0",
    "@hono/zod-validator": "^0.7.6",
    "ai": "^6.0.141",
    "alchemy": "^0.90.1",
    "better-result": "^2.7.0",
    "cloudflare": "^5.2.0",
    "commander": "^14.0.3",
    "hono": "^4.12.9",
    "octokit": "^5.0.5",
    "zod": "^4.3.6"
  }
}
